#compdef chroot

autoload -U is-at-least

_chroot() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--groups=[Comma-separated list of groups to switch to]:GROUP1,GROUP2...:_default' \
'--userspec=[Colon-separated user and group to switch to.]:USER:GROUP:_default' \
'--skip-chdir[Use this option to not change the working directory to / after changing the root directory to newroot, i.e., inside the chroot.]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'*::newroot:_default' \
&& ret=0
}

(( $+functions[_chroot_commands] )) ||
_chroot_commands() {
    local commands; commands=()
    _describe -t commands 'chroot commands' commands "$@"
}

if [ "$funcstack[1]" = "_chroot" ]; then
    _chroot "$@"
else
    compdef _chroot chroot
fi
